# SentinelOps — example environment configuration
#
# This file is a TEMPLATE and is committed to version control on purpose.
# Every value below is a placeholder. None of them are real credentials.
#
# Usage:
#   1. Copy this file to `.env` (or `.env.local`) in the same directory.
#   2. Replace every placeholder with a real value for your environment.
#
# The `.env` files themselves are ignored by Git (see .gitignore).
# NEVER commit real secrets, connection strings, API keys, or tokens.
# When you add a new variable to your local `.env`, add a placeholder for it
# here too, so other developers know the variable is required.

# API
# NODE_ENV is intentionally not set here. It is optional and validated against
# development | test | production, defaulting to "development" when unset. The
# test runner sets it to "test" itself, and deployments set it to "production",
# so pinning a value in .env would be wrong everywhere but one environment.
# Port the backend service listens on. Kept off 3000 so the web app can use it.
PORT=3001

# Logging
# Both are optional. When unset, each is derived from NODE_ENV:
#   production   -> LOG_LEVEL=log    LOG_FORMAT=json
#   test         -> LOG_LEVEL=warn   LOG_FORMAT=pretty
#   development  -> LOG_LEVEL=debug  LOG_FORMAT=pretty
# Set one only to override that derived default for a particular run.
#
# LOG_LEVEL is the minimum level to emit; every level at or above it is
# enabled. One of: verbose | debug | log | warn | error | fatal.
# LOG_LEVEL=debug
#
# LOG_FORMAT is `json` for one machine-parseable line per entry, or `pretty`
# for the colourised human format.
# LOG_FORMAT=pretty

# Database
# PostgreSQL connection string. Replace credentials for your environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelops

# Database used by the integration test suite (pnpm --filter @sentinelops/api test:integration).
#
# This MUST be a database of its own. The suite TRUNCATES every table it touches
# between tests, and it refuses to start unless the database name ends in `_test`
# and differs from DATABASE_URL's. It never falls back to DATABASE_URL.
#
# The database is created automatically on the first integration run if absent,
# and the committed migrations are applied to it.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelops_test

# PostgreSQL container (docker/docker-compose.yml)
# Credentials, database name, and host port for the local development database.
# Docker Compose reads these from this same file, so they must stay in sync with
# DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sentinelops
POSTGRES_PORT=5432

# Frontend
# Next.js reads its environment from apps/web, not from this file: set
# NEXT_PUBLIC_API_URL in apps/web/.env.local (see apps/web/.env.example).
# NEXT_PUBLIC_ variables are exposed to the browser — never put secrets there.

# Authentication
# Signing key for access tokens. Required — the API refuses to boot without it,
# and rejects anything shorter than 32 characters. Generate a strong random
# value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-secure-random-secret

# The `iss` claim stamped on every access token and required to match on
# verification. Optional; defaults to "sentinelops".
# JWT_ISSUER=sentinelops

# Access token lifetime in seconds. Optional; defaults to 900 (15 minutes).
# Kept short deliberately: the guard performs no database lookup, so expiry is
# what ends a session early. The refresh cookie covers the difference.
# JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in whole days. Optional; defaults to 30.
# REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to send credentialed requests, comma-separated.
# Optional; defaults to http://localhost:3000. The refresh cookie only reaches
# the API from an origin listed here, so the web app will not log in without it.
# CORS_ORIGIN=http://localhost:3000

# Features
# Whether the invitation routes exist. Optional; defaults to false. While off,
# every invitation route answers 404 exactly as an unknown path does, and an
# admin adds members directly with a one-time password. Keep it in step with
# NEXT_PUBLIC_INVITATIONS_ENABLED in apps/web.
# INVITATIONS_ENABLED=false
# Whether anyone may create an organization from the website. Optional;
# defaults to false. While off, POST /auth/register answers 404 exactly as an
# unknown path does: organizations are created by whoever runs the server,
# who switches this on for as long as that takes, and people join one only
# when its Admin adds them. Keep it in step with
# NEXT_PUBLIC_REGISTRATION_ENABLED in apps/web.
# REGISTRATION_ENABLED=false
