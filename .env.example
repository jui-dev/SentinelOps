# SentinelOps — example environment configuration
#
# This file is a TEMPLATE and is committed to version control on purpose.
# Every value below is a placeholder. None of them are real credentials.
#
# Usage:
#   1. Copy this file to `.env` (or `.env.local`) in the same directory.
#   2. Replace every placeholder with a real value for your environment.
#
# The `.env` files themselves are ignored by Git (see .gitignore).
# NEVER commit real secrets, connection strings, API keys, or tokens.
# When you add a new variable to your local `.env`, add a placeholder for it
# here too, so other developers know the variable is required.

# API
# Port the backend service listens on. Kept off 3000 so the web app can use it.
PORT=3001

# Database
# PostgreSQL connection string. Replace credentials for your environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/sentinelops

# Redis
# Used for caching, queues, and real-time pub/sub.
REDIS_URL=redis://localhost:6379

# Frontend
# Base URL the web app uses to reach the API.
# NEXT_PUBLIC_ variables are exposed to the browser — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Authentication
# Generate a strong random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-secure-random-secret
