// SentinelOps database schema.
//
// The core domain: an organization to own data, a user to act, and a membership
// that binds them with a role. Everything added later — teams, services,
// incidents, audit entries — hangs off these three.
//
// Conventions every later model follows:
//
//   * Tables and columns are snake_case via @@map/@map, so raw SQL and psql read
//     naturally without quoting every identifier.
//   * Ids are UUIDv7 in native Postgres `uuid` columns: 16 bytes rather than a
//     36-character string, and time-ordered, so primary-key inserts stay local
//     in the btree instead of scattering across it.
//   * Every timestamp is @db.Timestamptz(3). Prisma maps DateTime to `timestamp`
//     WITHOUT time zone by default, which is a footgun worth spelling out of.
//   * String columns are plain `text`. Length limits live in the Zod schemas at
//     the request boundary, which is where this project already validates —
//     duplicating them here means two places to change and a migration to widen.
//   * Tenant-owned tables carry organizationId, and every query on one filters
//     by it: `{ id, organizationId }`, never a lookup by id alone. Admitting a
//     request to an organization (OrganizationMembershipGuard) does not replace
//     that filter. Database-level tenant-consistency constraints are weighed per
//     relationship, not applied as a blanket rule.
//
// Since Prisma 7 the connection URL lives in prisma.config.ts (datasource.url),
// not in this block.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is ESM ("type": "module") and is compiled by tsc under
  // module/moduleResolution: nodenext, where relative imports must carry a
  // .js extension — the same convention used throughout src/. A generated
  // client importing with ".ts" specifiers would not compile.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"

  // Lets a unique index carry a WHERE clause, so an invariant such as "one open
  // invitation per organization and email" is declared here — where Prisma can
  // see it and will not treat it as drift — rather than in hand-written
  // migration SQL. A preview feature: re-check it when upgrading Prisma.
  previewFeatures = ["partialIndexes"]
}

/// A member's capacity in an organization: one role each, named for the job it
/// does in an incident.
///
///   ADMIN             sets the organization up — its members, teams,
///                     services, and roles — and may decide on any incident.
///                     Whoever creates an organization is its first admin.
///   INCIDENT_MANAGER  decides on incidents: severity, who responds, the
///                     responsible team, resolution, and the analysis.
///   REPORTER          raises incidents, and follows the ones they raised.
///   RESPONDER         does the operational work on their teams' incidents.
///                     Was MEMBER; renamed in place, so every existing member
///                     is a responder.
///
/// There was once an OWNER as well. It held exactly what ADMIN held, so it
/// distinguished nothing, and was merged into ADMIN.
///
/// What each role may do is role-permissions.ts, not this enum. A later stage
/// may introduce dedicated Role, Permission, or RolePermission structures that read
/// this value, supersede it, or migrate it away — nothing here should constrain that.
enum Role {
  ADMIN
  INCIDENT_MANAGER
  REPORTER
  RESPONDER

  @@map("role")
}

/// The tenancy root. Every domain table added from here on carries an organizationId.
///
/// Soft-deleted rather than removed: destroying a tenant would destroy its incident
/// history, which is the thing an operations platform exists to retain.
model Organization {
  id   String @id @default(uuid(7)) @db.Uuid
  name String
  /// URL-safe identifier, so a route can address an organization without exposing
  /// its id.
  slug String @unique

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the ordinary application delete, which is an UPDATE and therefore
  /// leaves memberships and every historical relationship intact. Reads filter on
  /// `deleted_at IS NULL`, organization admission included, so a soft-deleted
  /// organization is unreachable through every route beneath it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// The number most recently given to one of this organization's incidents.
  /// Declaring an incident increments it in the same transaction as the
  /// insert, so the row lock that UPDATE takes serializes concurrent
  /// declarations within one organization and each gets a distinct, larger
  /// number. Internal: never selected into a response.
  lastIncidentNumber Int @default(0) @map("last_incident_number")

  /// A demonstration organization: everything in it is generated, on a
  /// development machine, by the demo workspace (src/dev/). Real
  /// organizations never hold demo data, so the demo can be reset or removed
  /// as a whole without touching anything else. Never set in production.
  isDemo        Boolean        @default(false) @map("is_demo")
  /// The demo workspace's own record, on a demo organization alone.
  demoWorkspace DemoWorkspace?

  memberships        Membership[]
  invitations        Invitation[]
  teams              Team[]
  services           Service[]
  incidents          Incident[]
  incidentResponders IncidentResponder[]
  incidentAssignees  IncidentAssignee[]
  incidentAnalyses   IncidentAnalysis[]
  notifications      Notification[]
  knownIssues        KnownIssue[]
  activityEntries    ActivityEntry[]

  @@map("organizations")
}

/// A person. Global rather than tenant-scoped: one identity, one login, and a
/// Membership per organization they belong to.
///
/// Carries the password credential and nothing else about authentication. Email
/// verification and password reset both need mail delivery, which does not exist,
/// so emailVerifiedAt is not here yet — it is additive when verification arrives.
///
/// Soft-deleted rather than removed: a departed responder must still resolve as the
/// author of past incidents and comments.
model User {
  id                     String  @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase. Postgres unique indexes are case-sensitive, so normalisation
  /// happens at the Zod boundary rather than by adding the citext extension.
  email                  String  @unique
  /// The human-readable display identity for this actor — what an incident timeline,
  /// an assignment, or an audit entry renders instead of a uuid. Deliberately a
  /// single field: this is actor identity, not a user profile. Avatars, titles, time
  /// zones, contact methods, and notification preferences are not part of this stage.
  name                   String
  /// Argon2id PKC-encoded hash — algorithm, parameters, and salt travel inside the
  /// string, so rehashing at stronger parameters later needs no schema change.
  ///
  /// Nullable, reserved for identities without a local password — federated
  /// (SSO) or passwordless sign-in, neither of which exists yet. Every account
  /// created today sets one: invitations do not pre-create users, so an invitee's
  /// User is created, with a password, when they accept. Login treats null exactly
  /// as it treats a wrong password: one indistinguishable 401.
  ///
  /// Never selected except by the login lookup, and never mapped into a response.
  passwordHash           String? @map("password_hash")
  /// True while the password is one somebody else chose: an admin who added
  /// this person to an organization set a one-time password and handed it
  /// over. Until they choose their own, the account may sign in and change it,
  /// and nothing else — organization admission refuses it. Cleared by the
  /// password change; false for every account that chose its own password.
  passwordChangeRequired Boolean @default(false) @map("password_change_required")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  invitationsSent     Invitation[]       @relation("InvitationsSent")
  incidentsDeclared   Incident[]         @relation("IncidentsDeclared")
  incidentActivity    IncidentActivity[]
  analysesStarted     IncidentAnalysis[] @relation("IncidentAnalysesStarted")
  analysesPublished   IncidentAnalysis[] @relation("IncidentAnalysesPublished")
  /// Notifications about something this user did — never the ones they
  /// receive, which belong to a membership.
  notificationsCaused Notification[]
  /// Activity log entries this user caused, or — for a sign-in — whose
  /// account it was.
  activityEntries     ActivityEntry[]
  /// Memberships this user removed, as an Admin.
  membershipsRemoved  Membership[]       @relation("MembershipsRemoved")
  demoWorkspacesReset DemoWorkspace[]    @relation("DemoWorkspacesReset")

  @@map("users")
}

/// Binds a user to an organization with a capacity — the question every future
/// authorization check asks. Not a pure join table: it carries a role and its own
/// timestamps, which is why it is an explicit model.
///
/// A surrogate id rather than a composite key, so a later audit record or invitation
/// can reference one specific grant, and so a membership has a REST identity.
///
/// Removed, not deleted, when someone leaves: `removedAt` is set, and the row stays
/// so their responses, analyses, and timeline entries keep a member to point at —
/// the responder and analysis-owner keys are Restrict for exactly that. A removed
/// membership is a security hole if any check forgets it, so the rule is narrow:
/// admission refuses one (MembershipResolver), and every query that finds members
/// to act on, notify, place, assign, or count filters `removedAt: null`. Reads of
/// history do not, so the past still names them. Removal also deletes their team
/// placements and assignments, so team-based queries need no filter of their own.
/// test/member-removal.integration-spec.ts pins this, the race included.
///
/// The `onDelete: Cascade` below is referential integrity for a *physical* row
/// deletion (an erasure request, a local reset), not the ordinary lifecycle. The
/// ordinary delete of an organization or user writes `deleted_at` and touches no
/// foreign key, so memberships survive it.
model Membership {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           Role   @default(RESPONDER)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the Admin removed them from the organization; null while they
  /// belong. Restoring clears it. A CHECK keeps removedById null unless this
  /// is set.
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(3)
  /// Who removed them. SetNull: the record outlives the remover's account.
  removedById String?   @map("removed_by_id") @db.Uuid

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  removedBy           User?               @relation("MembershipsRemoved", fields: [removedById], references: [id], onDelete: SetNull)
  teamMemberships     TeamMembership[]
  /// Restrict, like the responder key itself: a membership that has
  /// responded to an incident cannot be physically deleted. Nothing in the
  /// application deletes a membership today; member removal, when it
  /// arrives, decides what happens to that history.
  incidentResponses   IncidentResponder[]
  /// Cascade, unlike the responder key: an assignment is a standing
  /// instruction, not a record of work done.
  incidentAssignments IncidentAssignee[]
  /// Restrict, like the responder key: the owner of an incident analysis
  /// cannot be physically deleted. Member removal, when it arrives, decides
  /// whether ownership moves first.
  analysesOwned       IncidentAnalysis[]
  /// This member's inbox in this organization. Cascades: revoking the grant
  /// removes what it was told, along with its access.
  notifications       Notification[]

  /// One capacity per user per organization: nobody is both ADMIN and MEMBER.
  @@unique([organizationId, userId])
  /// Logically redundant with the primary key, and there for one reason: a
  /// composite foreign key must reference a unique constraint over exactly its
  /// columns. TeamMembership references (organization_id, id), which is what
  /// lets the database itself refuse a team member from another organization.
  @@unique([organizationId, id])
  /// Postgres does not index foreign keys automatically. This serves "which
  /// organizations does this user belong to" — the lookup every authenticated
  /// request will make — and turns the cascade from `users` into an index scan.
  ///
  /// organization_id needs no index of its own: it is the leading column of the
  /// composite unique above, which already serves prefix lookups and that cascade.
  @@index([userId])
  @@map("memberships")
}

/// An offer of a membership: an organization's invitation for one email address
/// to join it in a given role.
///
/// A prospective grant, not an identity. Creating an invitation never creates a
/// User — a user is global, so one tenant creating an identity for an address
/// would be a cross-tenant side effect, and would claim the email before its
/// owner ever signed up. The User is created when the invitation is accepted.
///
/// Kept after it is accepted or revoked: it is the organization's record of who
/// was offered what, and by whom. Its status is derived, never stored — revoked,
/// else accepted, else expired, else pending. "Open" means neither accepted nor
/// revoked; an expired invitation is still open until it is replaced or revoked.
model Invitation {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Stored lowercase, normalised at the Zod boundary like users.email.
  email          String
  /// Any role. OWNER no longer exists.
  role           Role
  /// SHA-256 of the opaque token, hex encoded. The token itself is never
  /// stored; it is returned once, in the response that created the invitation.
  tokenHash      String @unique @map("token_hash")
  /// Who made the offer. Required, and Restrict rather than Cascade or SetNull:
  /// the ordinary delete of a user is soft and leaves this intact, and a
  /// physical deletion of someone with invitation history has to be a
  /// deliberate procedure that decides what happens to that history, not a
  /// side effect that erases or anonymises it.
  invitedById    String @map("invited_by_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)

  /// At most one open invitation per organization and email. Enforced here
  /// rather than by checking first, which races: re-inviting revokes the open
  /// one and inserts its replacement, and of two re-invites whose inserts
  /// overlap the second fails on this index. Expiry is deliberately not part of the
  /// predicate — an index predicate cannot read the clock.
  ///
  /// Prisma still generates an `organizationId_email` unique input for this
  /// index, and a findUnique through it would ignore the predicate. Never use
  /// it; an architecture spec forbids it.
  @@unique([organizationId, email], map: "invitations_open_organization_email_key", where: { acceptedAt: null, revokedAt: null })
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([invitedById])
  @@map("invitations")
}

/// A named group of an organization's members — the unit that owns services
/// and will respond to incidents.
///
/// Organizational configuration, not history, and hard-deleted. The deletion
/// principle every relationship follows: deleting configuration never silently
/// deletes operational resources or historical records. A team that owns
/// services cannot be deleted — the services' foreign key is Restrict, so the
/// delete is refused, never cascaded, until they are reassigned. A team that
/// has been responsible for any incident cannot be deleted at all: incidents
/// are never deleted, and their team key is Restrict too. It can be renamed.
///
/// Belonging to a team grants one thing: a MEMBER may respond to — post
/// operational updates on — the incidents their team is responsible for.
/// IncidentsService checks it, under the incident's row lock. There are no
/// team roles; everything else is authorized by the organization role alone.
model Team {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  /// Derived from the name when the team is created, never supplied by a
  /// client, and never changed afterwards: renaming writes `name` only, so a
  /// URL built from the slug keeps working. Navigation and internal reference,
  /// not content.
  ///
  /// Because it is derived, its uniqueness also refuses a second team whose
  /// name differs only by case or punctuation ("Platform", "platform!") — at
  /// creation. A rename is held only to the exact-name unique below.
  slug           String
  /// Null when there is none. An empty string is normalised to null at the
  /// Zod boundary, so there is one way to say "no description".
  description    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships   TeamMembership[]
  services      Service[]
  incidents     Incident[]
  notifications Notification[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  /// The target of composite foreign keys from tenant-owned children — team
  /// memberships, services, and incidents — and a lookup key that cannot be
  /// used without the organization: findUnique({ organizationId_id }).
  @@unique([organizationId, id])
  @@map("teams")
}

/// Places an organization member on a team.
///
/// References the organization Membership rather than the global User: a team
/// member is, by construction, a member of the organization, and removing
/// someone from the organization removes them from its teams by cascade.
///
/// Tenant consistency is a database invariant, not a service convention. Both
/// foreign keys are composite and share the one organization_id column, so the
/// team and the membership a row joins must belong to the same organization as
/// the row — and therefore to each other. Simple foreign keys on team_id and
/// membership_id alone would accept a team in one organization joined to a
/// membership in another.
///
/// Rows must be created with scalar ids (organizationId, teamId, membershipId),
/// not nested `connect`: the two relations share organizationId.
///
/// Hard lifecycle. The surrogate id follows the schema convention and is not
/// exposed; the API addresses a team member by its membership id.
model TeamMembership {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team       @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  /// A person is on a team at most once. Membership is one per user per
  /// organization, so this is also one per user per team. Its leading column
  /// serves the cascade from teams.
  @@unique([teamId, membershipId])
  /// Serves the cascade from memberships, and "which teams is this member on".
  @@index([membershipId])
  @@map("team_memberships")
}

/// How much an organization depends on a service: a classification people
/// choose, not an observed state. It is neither service health nor incident
/// severity, and nothing sorts or computes by it — it is shown, not scored.
///
/// Four plain words rather than numbered tiers, whose direction readers
/// disagree about, defined without any industry's vocabulary:
///
///   CRITICAL  failure stops the organization's core work or directly harms
///             its customers
///   HIGH      failure seriously degrades important work; workarounds are
///             limited
///   NORMAL    failure is disruptive but contained — the default
///   LOW       internal or peripheral; failure has little impact
enum ServiceCriticality {
  CRITICAL
  HIGH
  NORMAL
  LOW

  @@map("service_criticality")
}

/// An operational component the organization runs — an API, a processor, a
/// portal — owned by one of its teams. What incidents will be recorded
/// against.
///
/// Every service has an owner. A service nobody owns is exactly the ambiguity
/// an incident tool exists to remove, and a required owner means the composite
/// foreign key below is checked on every row.
///
/// Tenant consistency is a database invariant, as for team memberships: the
/// owner key is composite on the service's own organization_id, so the owning
/// team must belong to the service's organization however the row is written.
/// Rows are created with scalar ids (organizationId, ownerTeamId), not nested
/// `connect`: the two relations share organizationId.
///
/// The owner key is Restrict on delete, so a team that owns services cannot be
/// deleted until they are reassigned, and Restrict on update, so a team cannot
/// be moved to another organization carrying its services with it. A physical
/// deletion of the organization still removes both: the cascade reaches teams
/// and services in the same statement, and schema.integration-spec.ts proves
/// Postgres completes it.
///
/// Retired by archiving, not deleting. Incidents reference a service through a
/// Restrict key, so a service with incident history cannot be deleted — the
/// history would otherwise disappear with it. Archiving (archivedAt) keeps it
/// resolvable from every incident that names it while refusing new incidents
/// against it. Deletion remains for a service nothing references: a mistake.
model Service {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  /// Derived from the name when the service is created, never supplied by a
  /// client, and never changed afterwards — the same rules as Team.slug.
  /// Navigation and internal reference, not content.
  slug           String
  /// Null when there is none; blank is normalised to null at the Zod boundary.
  description    String?
  ownerTeamId    String             @map("owner_team_id") @db.Uuid
  criticality    ServiceCriticality @default(NORMAL)
  /// Set when the service is retired. The one rule it carries: no new
  /// incident may be declared against an archived service, which the
  /// declaration checks under a row lock. Everything else — reading it,
  /// renaming it, its existing incidents — is unaffected. Public lifecycle
  /// state, unlike a deletedAt: it is returned in responses.
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerTeam    Team         @relation(fields: [organizationId, ownerTeamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  incidents    Incident[]
  knownIssues  KnownIssue[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  /// A lookup key that cannot be used without the organization, and the
  /// target of the composite foreign key incidents carry.
  @@unique([organizationId, id])
  /// Serves the Restrict check when a team is deleted, and "which services
  /// does this team own".
  @@index([organizationId, ownerTeamId])
  @@map("services")
}

/// How serious one incident is — chosen for the incident, never derived from
/// its service's criticality: a CRITICAL service can have a SEV4 incident.
/// Numbered because that is the vocabulary responders already use, SEV1 the
/// most severe; the enum is declared in that order, so ORDER BY puts SEV1
/// first. Industry-neutral:
///
///   SEV1  Critical  core functionality unavailable, or major customer or
///                   business impact
///   SEV2  Major     serious degradation or substantial impact, short of a
///                   complete critical outage
///   SEV3  Moderate  limited or contained impact; normal operations largely
///                   continue
///   SEV4  Minor     a small operational issue with little immediate impact
enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4

  @@map("incident_severity")
}

/// Where the incident as a whole stands: one status, however many people
/// are working on it. It moves forward only, one step at a time — DECLARED →
/// INVESTIGATING → RESOLVED. RESOLVED is terminal: a resolved incident is not
/// changed again.
///
///   DECLARED       declared by the Admin; nobody has started investigating
///   INVESTIGATING  the first responder started investigating, which moves it
///   RESOLVED       closed by the Admin, once no responder is investigating
///
/// What one responder is doing is IncidentResponder.status, not this. A cause
/// found or a fix being watched is an operational update.
enum IncidentStatus {
  DECLARED
  INVESTIGATING
  RESOLVED

  @@map("incident_status")
}

/// An operational problem affecting one of the organization's services,
/// declared by a member. Operational history: never deleted by the
/// application, and nothing it references can be deleted from under it.
///
/// Tenant consistency is a database invariant, as for services. The service
/// and team keys are composite and share the incident's organization_id, so
/// both must belong to the incident's own organization however the row is
/// written. Rows are created with scalar ids, not nested `connect`.
///
/// teamId is the team responsible for this incident. It is copied from the
/// service's owner when the incident is declared — a snapshot, so reassigning
/// the service later does not rewrite who was responsible — and may be
/// reassigned explicitly while the incident is active, which the timeline
/// records. Its members are who may start investigating it; who did is
/// IncidentResponder. serviceId never changes after declaration.
///
/// Both keys are Restrict on delete, so a service or team an incident names
/// cannot be deleted, and Restrict on update, so neither can move to another
/// organization carrying incidents with it. A physical deletion of the
/// organization still removes everything: schema.integration-spec.ts proves
/// the cascade completes.
///
/// Three invariants live as CHECK constraints in the migrations, because
/// Prisma cannot declare them (and does not treat them as drift): status is
/// RESOLVED exactly when resolved_at is set, number is positive, and only a
/// resolved incident carries a resolution.
model Incident {
  id                String                 @id @default(uuid(7)) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  /// The organization's own sequence, shown as INC-{number}. Allocated from
  /// organizations.last_incident_number when the incident is declared:
  /// unique within the organization, never changed, and increasing in the
  /// order declarations commit. Not promised to be gapless.
  number            Int
  title             String
  /// The current understanding of the impact. Null when there is none; blank
  /// is normalised to null at the Zod boundary.
  summary           String?
  serviceId         String                 @map("service_id") @db.Uuid
  teamId            String                 @map("team_id") @db.Uuid
  severity          IncidentSeverity
  /// Whether whoever decides on incidents has settled the severity. False
  /// only while a Reporter's declaration waits for that decision: the
  /// severity they declared with is then a suggestion. Set by the decision
  /// on who responds, or by any change of severity, and never cleared.
  severityConfirmed Boolean                @default(true) @map("severity_confirmed")
  status            IncidentStatus         @default(DECLARED)
  /// Who may start responding. The people an ASSIGNED incident names are its
  /// assignees.
  responseAccess    IncidentResponseAccess @default(OPEN) @map("response_access")
  /// Who declared it: the global User rather than the Membership. A
  /// membership is hard-deleted when access is revoked, and attribution must
  /// outlive the grant; a user is soft-deleted and keeps resolving. Restrict,
  /// like invitations.invited_by_id: a physical erasure must be a deliberate
  /// procedure, not a cascade. Users are global, so this is the one reference
  /// the database cannot hold to the organization — IncidentsService takes it
  /// from the admitted membership and never from a request body.
  createdById       String                 @map("created_by_id") @db.Uuid

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the server in the same write that sets RESOLVED; never supplied
  /// by a client.
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// How the incident ended, in the Admin's words: required by every
  /// resolution, written in the same write as RESOLVED and again as the
  /// message of the resolution's timeline entry — state here, history there,
  /// as severity is. Resolved is final, so the two never diverge. Null on
  /// active incidents, and on incidents resolved before notes were required:
  /// those are not given one after the fact.
  resolution   String?
  /// The known issue this incident is an occurrence of, when it is one:
  /// always one of the incident's own service's, which the composite key
  /// below holds the database to. Null for a one-off.
  knownIssueId String?   @map("known_issue_id") @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service             @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  team         Team                @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User                @relation("IncidentsDeclared", fields: [createdById], references: [id], onDelete: Restrict)
  responders   IncidentResponder[]
  assignees    IncidentAssignee[]
  activity     IncidentActivity[]
  analysis     IncidentAnalysis?
  knownIssue   KnownIssue?         @relation(fields: [organizationId, serviceId, knownIssueId], references: [organizationId, serviceId, id], onDelete: Restrict, onUpdate: Restrict)

  /// The addressing key: the API names an incident by its number within the
  /// organization. Also serves keyset pages ordered by number.
  @@unique([organizationId, number])
  /// Redundant with the primary key; the target of the composite foreign keys
  /// incident_responders and incident_activities carry.
  @@unique([organizationId, id])
  /// Serves the Restrict check when a service is deleted.
  @@index([organizationId, serviceId])
  /// Serves the Restrict check when a team is deleted.
  @@index([organizationId, teamId])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([createdById])
  /// Serves the overview's count of incidents declared in a period.
  @@index([organizationId, createdAt])
  /// Serves the overview's resolved-in-a-period count and its most recent.
  @@index([organizationId, resolvedAt])
  /// Serves a known issue's occurrences, and the Restrict check when one is
  /// removed by a merge.
  @@index([organizationId, knownIssueId])
  @@map("incidents")
}

/// A problem a service has had before, kept so the next time it happens it
/// can be declared by choosing it rather than retyping it, and so its
/// repeats are counted. One service's: an incident links to a known issue
/// of its own service only.
///
/// usualSeverity is a suggestion the declare form starts from, never a rule:
/// each incident keeps the severity it was declared with.
///
/// pendingReview marks one saved while declaring something new, for the
/// Admin to keep, rename, or merge into another; one the Admin made or has
/// looked at is not pending. Archived ones are no longer offered when
/// declaring, and keep their incidents. A known issue is only ever removed
/// by merging it into another, which first moves its incidents.
model KnownIssue {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  serviceId      String           @map("service_id") @db.Uuid
  name           String
  /// Null when there is none; blank is normalised to null at the Zod boundary.
  description    String?
  usualSeverity  IncidentSeverity @map("usual_severity")
  pendingReview  Boolean          @default(false) @map("pending_review")
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// A service with no incidents may be deleted, and takes its known issues
  /// with it; one with incidents cannot be.
  service      Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  incidents    Incident[]

  /// One name per service, as written. Case-insensitive duplicates are
  /// refused by KnownIssuesService.
  @@unique([serviceId, name])
  @@unique([organizationId, id])
  /// The target of the incidents' key, which holds a link to the same service.
  @@unique([organizationId, serviceId, id])
  @@index([organizationId, serviceId])
  @@map("known_issues")
}

/// Where one responder's own part of the response stands. Two values, and
/// no others: someone who has not started investigating has no responder row
/// at all, so only actual participation is ever recorded.
///
///   INVESTIGATING  started investigating, and still working on it
///   COMPLETED      marked their own response complete; final for them
///
/// Completing a response is not resolving the incident — only the Admin
/// resolves, and only while no responder is INVESTIGATING.
/// Who may start responding to an incident: nobody until the Admin chooses,
/// anyone on its responsible team, or only the people assigned.
enum IncidentResponseAccess {
  PENDING
  OPEN
  ASSIGNED

  @@map("incident_response_access")
}

/// A member the Admin has named to work on an incident. Being here lets them
/// start a response; it is not a response. Built like IncidentResponder, with
/// both foreign keys composite and sharing organizationId.
model IncidentAssignee {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  incidentId     String   @map("incident_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([incidentId, membershipId])
  /// Serves the read scope's "assigned to them".
  @@index([membershipId])
  @@index([organizationId])
  @@map("incident_assignees")
}

enum IncidentResponderStatus {
  INVESTIGATING
  COMPLETED

  @@map("incident_responder_status")
}

/// One member's response to an incident: created when they start
/// investigating, completed when they mark their response complete.
///
/// Whoever IncidentResponseAccess lets start creates their own row. At most one row per member per incident, so starting twice
/// cannot record a second response, and a completed response is not
/// restarted. A row outlives a reassignment of the incident's team: whoever
/// started keeps their response and may finish it.
///
/// Built like TeamMembership: both foreign keys are composite and share the
/// one organization_id column, so the incident and the membership must belong
/// to the row's own organization, however it is written. Rows are created with
/// scalar ids, not nested `connect`. The membership key is Restrict; the
/// incident key cascades, which only a physical deletion of the organization
/// ever exercises.
///
/// It also carries a plain key to its organization, which cascades, as
/// incidents do. Without it, a physical deletion of the organization would
/// reach these rows only through incidents — one cascade later than the
/// memberships, whose Restrict check would then find them still there and
/// refuse the deletion.
///
/// One invariant lives as a CHECK constraint in the migration, because Prisma
/// cannot declare it: status is COMPLETED exactly when completed_at is set.
model IncidentResponder {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  incidentId     String                  @map("incident_id") @db.Uuid
  membershipId   String                  @map("membership_id") @db.Uuid
  status         IncidentResponderStatus @default(INVESTIGATING)

  /// When they started investigating: set with the row, under the incident's
  /// row lock, as timeline entries are.
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  /// When they marked their response complete; set in the same write as
  /// COMPLETED, never supplied by a client.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  /// A member responds to an incident at most once. Its leading column serves
  /// the cascade from incidents, listing an incident's responders, and
  /// counting those still investigating before a resolution.
  @@unique([incidentId, membershipId])
  /// Serves a member's responses, most recently started first — keyset
  /// pages over (started_at, id) — and, by its leading column, the Restrict
  /// check when a membership is deleted.
  @@index([membershipId, startedAt])
  /// Serves the cascade from organizations, and the overview's count of who
  /// is investigating now, which reads the organization's INVESTIGATING
  /// rows and nothing else.
  @@index([organizationId, status])
  @@map("incident_responders")
}

/// What an incident's timeline entry records. UPDATE is written by a member;
/// the others are written by the server, in the transaction of the change
/// they describe. Resolution is STATUS_CHANGED to RESOLVED. TEAM_CHANGED is a
/// reassignment of the responsible team, which changes who may start
/// investigating. RESPONSE_STARTED and RESPONSE_COMPLETED are a responder
/// starting and completing their own response, attributed to them.
/// RESPONSE_ACCESS_CHANGED is the Admin choosing who may respond: from and to
/// the access, with the people assigned, by name, as its message.
enum IncidentActivityType {
  DECLARED
  UPDATE
  SEVERITY_CHANGED
  STATUS_CHANGED
  TEAM_CHANGED
  RESPONSE_STARTED
  RESPONSE_COMPLETED
  RESPONSE_ACCESS_CHANGED
  /// A suggested severity settled by whoever decides: fromValue the
  /// suggestion, toValue the severity confirmed, the same when it was kept.
  SEVERITY_CONFIRMED

  @@map("incident_activity_type")
}

/// One entry on an incident's timeline: an operational update posted by a
/// member, or a lifecycle change recorded by the server.
///
/// History, not state. The incident row is the source of its current state;
/// nothing is ever reconstructed by replaying these rows. Entries are never
/// changed or deleted by the application.
///
/// The incident key is composite on the shared organization_id, so an entry
/// cannot be attached to another organization's incident. The actor is the
/// global User, for the reason Incident.createdById gives: attribution must
/// outlive the membership. It is taken from the admitted membership, never
/// from a body.
///
/// createdAt is set by IncidentsService while it holds the incident's row
/// lock, not left to the column default (the transaction's start), so entries
/// sort in the order their changes applied.
///
/// message is set for UPDATE, and for the resolution — STATUS_CHANGED to
/// RESOLVED — where it is the resolution note. fromValue and toValue carry values as
/// text: DECLARED sets toValue to the declared severity; SEVERITY_CHANGED and
/// STATUS_CHANGED set both to enum values. TEAM_CHANGED sets both to team
/// names as they were at the time — a snapshot, like a severity, because the
/// team it moved from may later be renamed or deleted. RESPONSE_STARTED and
/// RESPONSE_COMPLETED set neither: the actor is the responder.
model IncidentActivity {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  incidentId     String               @map("incident_id") @db.Uuid
  type           IncidentActivityType
  actorId        String               @map("actor_id") @db.Uuid
  message        String?
  fromValue      String?              @map("from_value")
  toValue        String?              @map("to_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident      Incident       @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  actor         User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  notifications Notification[]

  /// Redundant with the primary key; the target of the composite foreign key
  /// notifications carry, so a notification cannot point at another
  /// organization's timeline entry.
  @@unique([organizationId, id])
  /// Serves reading an incident's timeline in order, and the cascade.
  @@index([incidentId, createdAt])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([actorId])
  /// Serves the organization's operational activity: every entry recorded in
  /// a period of days, read as one range rather than gathered from each
  /// incident's own timeline.
  @@index([organizationId, createdAt])
  /// Serves one member's response activity: what one actor wrote in this
  /// organization over a period of days. The index above cannot, since its
  /// second column is the date rather than the actor; the actor_id index
  /// above cannot either, since it knows neither organization nor date, and
  /// it stays because the Restrict check on a user needs exactly it.
  @@index([organizationId, actorId, createdAt])
  @@map("incident_activities")
}

/// Where an incident analysis stands. It moves forward once, DRAFT →
/// PUBLISHED, and a published analysis's written sections are final.
///
///   DRAFT      being written by its owner; readable by the organization
///   PUBLISHED  the organization's record of the incident
enum IncidentAnalysisStatus {
  DRAFT
  PUBLISHED

  @@map("incident_analysis_status")
}

/// What the organization learned from one resolved incident: a short
/// written account, owned by one member, drafted and then published.
///
/// Only what people must write is stored here. Everything SentinelOps already
/// knows — duration, severity, responders, the timeline, the resolution — is
/// read from the incident, which is final once resolved, so reading it live
/// is reading a snapshot and nothing is copied.
///
/// One per incident, by the unique key below, and only for a resolved
/// incident. That second rule spans two tables, so it is not a constraint:
/// the service checks it when the analysis is started, and RESOLVED being
/// terminal means the check can never become false afterwards.
///
/// Tenant consistency is a database invariant, as for responders. The
/// incident and owner keys are composite on the shared organization_id, so
/// both must belong to the analysis's own organization however the row is
/// written. Rows are created with scalar ids, not nested `connect`. The owner
/// key is Restrict; the incident key cascades, which only a physical deletion
/// of the organization ever exercises.
///
/// It also carries a plain key to its organization, which cascades, for the
/// reason IncidentResponder gives: reached only through incidents, these rows
/// would still be present when the memberships' Restrict check ran, and a
/// physical deletion of the organization would be refused.
///
/// Three invariants live as CHECK constraints in the migration, because
/// Prisma cannot declare them: status is PUBLISHED exactly when published_at
/// and published_by_id are set, a published analysis has a summary, and
/// version is positive.
model IncidentAnalysis {
  id                String                 @id @default(uuid(7)) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  incidentId        String                 @map("incident_id") @db.Uuid
  status            IncidentAnalysisStatus @default(DRAFT)
  /// The member accountable for writing it: a responsibility held now, so
  /// the organization Membership, as a responder is. Who started or
  /// published it is attribution, and is a User below.
  ownerMembershipId String                 @map("owner_membership_id") @db.Uuid
  /// Identifies one state of this row. Every write names the version it was
  /// based on and increments it, so a write based on anything older changes
  /// nothing — no edit is lost, and what is published is what was read.
  version           Int                    @default(1)

  /// The written sections. Null when not written; blank is normalised to
  /// null at the Zod boundary. Summary is the only one publication
  /// requires: impact, cause, and lessons may honestly be unknown, and a
  /// published analysis says so rather than demanding certainty.
  summary String?
  impact  String?
  cause   String?
  lessons String?

  /// Which sections their writer has said are finished, by name. Holding text
  /// does not make a section done: a draft is work in progress until someone
  /// says otherwise. A CHECK keeps this to the four section names.
  doneSections String[] @default([]) @map("done_sections")

  /// Who started it, and who published it: global Users, since attribution
  /// must outlive the membership, as Incident.createdById explains. Restrict,
  /// like it. Taken from the admitted membership, never from a body.
  createdById   String  @map("created_by_id") @db.Uuid
  publishedById String? @map("published_by_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the server in the same write that sets PUBLISHED.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  owner        Membership   @relation(fields: [organizationId, ownerMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("IncidentAnalysesStarted", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy  User?        @relation("IncidentAnalysesPublished", fields: [publishedById], references: [id], onDelete: Restrict)

  /// One analysis per incident. The organization is part of the key only
  /// because a one-to-one relation must be unique over exactly its foreign
  /// key's columns; the composite key into incidents already allows one
  /// organization per incident, so this is uniqueness per incident. It also
  /// serves the cascade from incidents, from organizations by its leading
  /// column, and reading an incident's analysis — always organization-scoped.
  @@unique([organizationId, incidentId])
  /// Serves the Restrict check when a membership is deleted.
  @@index([organizationId, ownerMembershipId])
  /// Serve the Restrict checks when a user row is physically deleted.
  @@index([createdById])
  @@index([publishedById])
  @@map("incident_analyses")
}

/// What a notification tells its recipient. Named for what it means to them,
/// not for the change that caused it: a response completing is, to the
/// Admin, an incident that is ready to resolve.
///
/// The INCIDENT_ types point at the timeline entry of the change they report,
/// which holds its values, its time, and its actor. The TEAM_ types point at
/// a team: a placement writes no timeline entry. A CHECK constraint in the
/// migration holds each type to exactly its subject, and names every type
/// explicitly, so a value added here is refused until it is given one.
enum NotificationType {
  /// Declared against a service the recipient's team owns.
  INCIDENT_DECLARED
  /// The responsible team changed: to the recipient's team, or away from
  /// the team of a response they still have under way.
  INCIDENT_REASSIGNED
  INCIDENT_SEVERITY_CHANGED
  INCIDENT_RESOLVED
  /// The last response under way completed; the Admin may now resolve it.
  INCIDENT_READY_TO_RESOLVE
  /// The Admin opened the incident to the recipient's team: anyone on it
  /// may now start.
  INCIDENT_OPENED_TO_TEAM
  /// The Admin assigned the recipient to the incident: they may now start.
  INCIDENT_ASSIGNED
  /// The severity the recipient suggested when declaring was confirmed.
  INCIDENT_SEVERITY_CONFIRMED
  TEAM_MEMBERSHIP_ADDED
  TEAM_MEMBERSHIP_REMOVED

  @@map("notification_type")
}

/// One recipient's record that something relevant happened: the in-app
/// inbox behind the notification bell.
///
/// What happened, not what is waiting. Operational attention is derived from
/// the incidents as they stand and is never stored; a notification is
/// written once, when its event happens, and is not withdrawn when the
/// situation it described changes. Reading one changes nothing but readAt.
///
/// Addressed to a Membership, not a User, so a notification belongs to one
/// organization by construction. The recipient key is composite on the
/// shared organization_id, as for team memberships and responders, so a
/// recipient from another organization is unrepresentable however the row
/// is written; so are the timeline entry and the team. Rows are created with
/// scalar ids, not nested `connect`. Every composite key is Restrict on
/// update, so nothing a notification names can move to another organization
/// carrying it along.
///
/// Structured, never rendered. It carries its type and references; the
/// incident, its number and title, the values that changed, and the team's
/// name are read through them, so the wording lives in the client. There is
/// no incident key: the timeline entry names its incident, and a second copy
/// would be an invariant nothing enforces.
///
/// Deletion follows what it refers to. Revoking a membership removes its
/// inbox, by cascade: nobody keeps an organization's news after losing the
/// organization. Deleting a team removes the notifications about being
/// placed on it. Timeline entries are never deleted by the application, so
/// their cascade only runs when an organization is physically deleted.
///
/// The actor is the global User, for the reason Incident.createdById gives,
/// and Restrict like it. For incident types it is also the timeline entry's
/// actor; it is stored because team types have no entry to take it from.
model Notification {
  id                    String           @id @default(uuid(7)) @db.Uuid
  organizationId        String           @map("organization_id") @db.Uuid
  recipientMembershipId String           @map("recipient_membership_id") @db.Uuid
  type                  NotificationType
  actorId               String           @map("actor_id") @db.Uuid
  /// Set exactly for INCIDENT_ types: the timeline entry of the change.
  activityId            String?          @map("activity_id") @db.Uuid
  /// Set exactly for TEAM_ types: the team placed on or taken off.
  teamId                String?          @map("team_id") @db.Uuid
  /// Set once, when the recipient reads it; never cleared.
  readAt                DateTime?        @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    Membership        @relation(fields: [organizationId, recipientMembershipId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  actor        User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  activity     IncidentActivity? @relation(fields: [organizationId, activityId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  team         Team?             @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  /// One notification per recipient per timeline entry: the backstop against
  /// a change reported twice. Team types have no entry, and Postgres treats
  /// NULLs as distinct, so they are not constrained by it. Its leading column
  /// serves the cascade from memberships.
  @@unique([recipientMembershipId, activityId])
  /// Serves the inbox: one recipient's notifications, newest first, in keyset
  /// pages over (created_at, id).
  @@index([recipientMembershipId, createdAt, id])
  /// Serves the unread count and marking read up to a point: only unread
  /// rows are in it, so it stays as small as the unread backlog.
  @@index([recipientMembershipId, createdAt], map: "notifications_unread_recipient_membership_id_created_at_idx", where: { readAt: null })
  /// Serve the cascades from timeline entries and teams, and by their
  /// leading column the cascade from organizations.
  @@index([organizationId, activityId])
  @@index([organizationId, teamId])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([actorId])
  @@map("notifications")
}

/// One issued refresh token. A row per token rather than per session, because
/// rotation means a session is a *chain* of tokens: every refresh revokes the
/// presented token and inserts its successor.
///
/// Hard lifecycle. These are credentials, not history — an expired or revoked row
/// is reaped, not preserved, and nothing references one after it dies.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque token, hex encoded. The token itself is never stored,
  /// so a database disclosure yields nothing a client can present.
  ///
  /// SHA-256 rather than Argon2, which would be wrong twice over: the token is 256
  /// bits from a CSPRNG, so there is no low-entropy guess for a slow hash to
  /// frustrate, and lookup happens *by* this value — which needs to be
  /// deterministic and indexable, exactly what a per-row salt destroys.
  tokenHash String @unique @map("token_hash")

  /// Shared by every token descended from one login, and the reason reuse
  /// detection works: a token replayed after the legitimate client has rotated
  /// past it kills the whole lineage rather than leaving both parties working.
  ///
  /// Not a foreign key — the family has no row of its own. Making it one would
  /// mean a sessions table this stage has no other use for.
  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set on rotation, on logout, and on every token in a family when reuse is
  /// detected. A revoked row is kept until it expires precisely so that replaying
  /// it can be *noticed*; deleting it on rotation would make reuse look like an
  /// unknown token.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves the cascade from users, and revoking every session a person holds.
  @@index([userId])
  /// Serves reuse detection, which revokes an entire family in one statement.
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Which part of the organization an activity log entry is about. The
/// Admin's log filters by it, and SECURITY entries — sign-ins and passwords —
/// are kept on a tab of their own. Always the one its action implies:
/// ActivityRecorder sets it from the action, never from a caller.
enum ActivityArea {
  PEOPLE
  TEAMS
  SERVICES
  KNOWN_ISSUES
  ORGANIZATION
  SECURITY

  @@map("activity_area")
}

/// What happened, in the activity log. The organization's setup — people,
/// teams, services, known issues, its own settings — and its members'
/// sign-ins. Incidents keep their own history in IncidentActivity.
enum ActivityAction {
  MEMBER_ADDED
  ROLE_CHANGED
  PASSWORD_RESET
  MEMBER_REMOVED
  MEMBER_RESTORED
  INVITATION_SENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_DELETED
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED
  KNOWN_ISSUE_CREATED
  KNOWN_ISSUE_UPDATED
  KNOWN_ISSUE_MERGED
  ORGANIZATION_UPDATED
  SIGNED_IN
  SIGN_IN_FAILED
  SIGN_IN_BLOCKED
  PASSWORD_CHANGED

  @@map("activity_action")
}

/// The kind of thing an entry is about, so the log can link to it while it
/// still exists.
enum ActivitySubjectType {
  MEMBERSHIP
  INVITATION
  TEAM
  SERVICE
  KNOWN_ISSUE
  ORGANIZATION

  @@map("activity_subject_type")
}

/// One entry in an organization's activity log: a change to its setup, or a
/// sign-in to a member's account. Read by the Admin alone.
///
/// History, never state, and permanent: the application only ever inserts
/// these rows. Nothing updates or deletes one; only removing the whole
/// organization takes its log with it.
///
/// Written by the change's own transaction (see activity.recorder.ts), so a
/// change and its entry are saved together or not at all.
///
/// Names are snapshots, taken when it happened — actorName, subjectName, and
/// the values in changes — so an entry still reads correctly after the person
/// or thing it names is renamed or deleted. subjectId keeps the link for as
/// long as the subject exists; it is not a foreign key, since the subject may
/// be deleted and the entry must outlive it.
///
/// changes is the list of fields that changed, each
/// { "field": "role", "before": "RESPONDER", "after": "INCIDENT_MANAGER" },
/// with a null side for a value that did not exist. Empty when nothing has a
/// before and after to show, such as a sign-in.
///
/// ipAddress and userAgent are the request's, as the server received it; null
/// when the entry was written outside a request.
model ActivityEntry {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  action         ActivityAction
  area           ActivityArea
  /// Who did it; for a sign-in, whose account it was.
  actorId        String               @map("actor_id") @db.Uuid
  actorName      String               @map("actor_name")
  subjectType    ActivitySubjectType? @map("subject_type")
  subjectId      String?              @map("subject_id") @db.Uuid
  subjectName    String?              @map("subject_name")
  changes        Json                 @default("[]")
  ipAddress      String?              @map("ip_address")
  userAgent      String?              @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Serves the log newest first, all areas.
  @@index([organizationId, createdAt])
  /// Serves the log filtered to one area, and the Security tab.
  @@index([organizationId, area, createdAt])
  /// Serves "done by" one person.
  @@index([organizationId, actorId, createdAt])
  /// Serves an entry's earlier history: the entries about the same subject.
  @@index([organizationId, subjectId, createdAt])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([actorId])
  @@map("activity_entries")
}

/// A demo organization's record of its own upkeep (src/dev/demo-workspace/):
/// when it was last reset, by whom, and the day its generated history ends
/// on. One row per demo organization, made by its first reset; a real
/// organization never has one.
model DemoWorkspace {
  organizationId String    @id @map("organization_id") @db.Uuid
  lastResetAt    DateTime? @map("last_reset_at") @db.Timestamptz(3)
  lastResetById  String?   @map("last_reset_by_id") @db.Uuid
  /// 00:00 UTC of the day the generated history ends on.
  historyEndsAt  DateTime? @map("history_ends_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastResetBy  User?        @relation("DemoWorkspacesReset", fields: [lastResetById], references: [id], onDelete: SetNull)

  @@map("demo_workspaces")
}
