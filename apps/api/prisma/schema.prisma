// SentinelOps database schema.
//
// The core domain: an organization to own data, a user to act, and a membership
// that binds them with a role. Everything added later — teams, services,
// incidents, audit entries — hangs off these three.
//
// Conventions every later model follows:
//
//   * Tables and columns are snake_case via @@map/@map, so raw SQL and psql read
//     naturally without quoting every identifier.
//   * Ids are UUIDv7 in native Postgres `uuid` columns: 16 bytes rather than a
//     36-character string, and time-ordered, so primary-key inserts stay local
//     in the btree instead of scattering across it.
//   * Every timestamp is @db.Timestamptz(3). Prisma maps DateTime to `timestamp`
//     WITHOUT time zone by default, which is a footgun worth spelling out of.
//   * String columns are plain `text`. Length limits live in the Zod schemas at
//     the request boundary, which is where this project already validates —
//     duplicating them here means two places to change and a migration to widen.
//   * Tenant-owned tables carry organizationId, and every query on one filters
//     by it: `{ id, organizationId }`, never a lookup by id alone. Admitting a
//     request to an organization (OrganizationMembershipGuard) does not replace
//     that filter. Database-level tenant-consistency constraints are weighed per
//     relationship, not applied as a blanket rule.
//
// Since Prisma 7 the connection URL lives in prisma.config.ts (datasource.url),
// not in this block.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is ESM ("type": "module") and is compiled by tsc under
  // module/moduleResolution: nodenext, where relative imports must carry a
  // .js extension — the same convention used throughout src/. A generated
  // client importing with ".ts" specifiers would not compile.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"

  // Lets a unique index carry a WHERE clause, so an invariant such as "one open
  // invitation per organization and email" is declared here — where Prisma can
  // see it and will not treat it as drift — rather than in hand-written
  // migration SQL. A preview feature: re-check it when upgrading Prisma.
  previewFeatures = ["partialIndexes"]
}

/// A member's capacity in an organization. Two, deliberately:
///
///   ADMIN   sets the organization up — its members, teams, and services — and
///           may act on anything within it. Whoever creates an organization
///           is its first admin.
///   MEMBER  does the operational work.
///
/// There was once an OWNER as well. It held exactly what ADMIN held, so it
/// distinguished nothing, and was merged into ADMIN.
///
/// This does not commit the eventual authorization model to any shape. A later stage
/// may introduce dedicated Role, Permission, or RolePermission structures that read
/// this value, supersede it, or migrate it away — nothing here should constrain that.
enum Role {
  ADMIN
  MEMBER

  @@map("role")
}

/// The tenancy root. Every domain table added from here on carries an organizationId.
///
/// Soft-deleted rather than removed: destroying a tenant would destroy its incident
/// history, which is the thing an operations platform exists to retain.
model Organization {
  id   String @id @default(uuid(7)) @db.Uuid
  name String
  /// URL-safe identifier, so a route can address an organization without exposing
  /// its id.
  slug String @unique

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the ordinary application delete, which is an UPDATE and therefore
  /// leaves memberships and every historical relationship intact. Reads filter on
  /// `deleted_at IS NULL`, organization admission included, so a soft-deleted
  /// organization is unreachable through every route beneath it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// The number most recently given to one of this organization's incidents.
  /// Declaring an incident increments it in the same transaction as the
  /// insert, so the row lock that UPDATE takes serializes concurrent
  /// declarations within one organization and each gets a distinct, larger
  /// number. Internal: never selected into a response.
  lastIncidentNumber Int @default(0) @map("last_incident_number")

  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  services    Service[]
  incidents   Incident[]

  @@map("organizations")
}

/// A person. Global rather than tenant-scoped: one identity, one login, and a
/// Membership per organization they belong to.
///
/// Carries the password credential and nothing else about authentication. Email
/// verification and password reset both need mail delivery, which does not exist,
/// so emailVerifiedAt is not here yet — it is additive when verification arrives.
///
/// Soft-deleted rather than removed: a departed responder must still resolve as the
/// author of past incidents and comments.
model User {
  id           String  @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase. Postgres unique indexes are case-sensitive, so normalisation
  /// happens at the Zod boundary rather than by adding the citext extension.
  email        String  @unique
  /// The human-readable display identity for this actor — what an incident timeline,
  /// an assignment, or an audit entry renders instead of a uuid. Deliberately a
  /// single field: this is actor identity, not a user profile. Avatars, titles, time
  /// zones, contact methods, and notification preferences are not part of this stage.
  name         String
  /// Argon2id PKC-encoded hash — algorithm, parameters, and salt travel inside the
  /// string, so rehashing at stronger parameters later needs no schema change.
  ///
  /// Nullable, reserved for identities without a local password — federated
  /// (SSO) or passwordless sign-in, neither of which exists yet. Every account
  /// created today sets one: invitations do not pre-create users, so an invitee's
  /// User is created, with a password, when they accept. Login treats null exactly
  /// as it treats a wrong password: one indistinguishable 401.
  ///
  /// Never selected except by the login lookup, and never mapped into a response.
  passwordHash String? @map("password_hash")
  /// True while the password is one somebody else chose: an admin who added
  /// this person to an organization set a one-time password and handed it
  /// over. Until they choose their own, the account may sign in and change it,
  /// and nothing else — organization admission refuses it. Cleared by the
  /// password change; false for every account that chose its own password.
  passwordChangeRequired Boolean @default(false) @map("password_change_required")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  invitationsSent   Invitation[]       @relation("InvitationsSent")
  incidentsDeclared Incident[]         @relation("IncidentsDeclared")
  incidentActivity  IncidentActivity[]

  @@map("users")
}

/// Binds a user to an organization with a capacity — the question every future
/// authorization check asks. Not a pure join table: it carries a role and its own
/// timestamps, which is why it is an explicit model.
///
/// A surrogate id rather than a composite key, so a later audit record or invitation
/// can reference one specific grant, and so a membership has a REST identity.
///
/// Hard lifecycle, unlike its two parents: revoking access must actually remove the
/// grant. A soft-deleted membership that a future authorization check forgets to
/// filter is a security hole, not a data-loss risk — and the record of what someone
/// did lives in incidents and audit entries, not in the grant that permitted it.
///
/// The `onDelete: Cascade` below is referential integrity for a *physical* row
/// deletion (an erasure request, a local reset), not the ordinary lifecycle. The
/// ordinary delete of an organization or user writes `deleted_at` and touches no
/// foreign key, so memberships survive it.
model Membership {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  role           Role   @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMemberships TeamMembership[]
  incidentsLed    Incident[]          @relation("IncidentLead")
  incidentsJoined IncidentResponder[]
  // incidentsLed and incidentsJoined are Restrict: a membership that has led
  // or responded to an incident cannot be physically deleted. Nothing in the
  // application deletes a membership today; when removing members arrives, it
  // decides what happens to that history.

  /// One capacity per user per organization: nobody is both ADMIN and MEMBER.
  @@unique([organizationId, userId])
  /// Logically redundant with the primary key, and there for one reason: a
  /// composite foreign key must reference a unique constraint over exactly its
  /// columns. TeamMembership references (organization_id, id), which is what
  /// lets the database itself refuse a team member from another organization.
  @@unique([organizationId, id])
  /// Postgres does not index foreign keys automatically. This serves "which
  /// organizations does this user belong to" — the lookup every authenticated
  /// request will make — and turns the cascade from `users` into an index scan.
  ///
  /// organization_id needs no index of its own: it is the leading column of the
  /// composite unique above, which already serves prefix lookups and that cascade.
  @@index([userId])
  @@map("memberships")
}

/// An offer of a membership: an organization's invitation for one email address
/// to join it in a given role.
///
/// A prospective grant, not an identity. Creating an invitation never creates a
/// User — a user is global, so one tenant creating an identity for an address
/// would be a cross-tenant side effect, and would claim the email before its
/// owner ever signed up. The User is created when the invitation is accepted.
///
/// Kept after it is accepted or revoked: it is the organization's record of who
/// was offered what, and by whom. Its status is derived, never stored — revoked,
/// else accepted, else expired, else pending. "Open" means neither accepted nor
/// revoked; an expired invitation is still open until it is replaced or revoked.
model Invitation {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Stored lowercase, normalised at the Zod boundary like users.email.
  email          String
  /// ADMIN or MEMBER. OWNER is refused by the request schema, not here.
  role           Role
  /// SHA-256 of the opaque token, hex encoded. The token itself is never
  /// stored; it is returned once, in the response that created the invitation.
  tokenHash      String @unique @map("token_hash")
  /// Who made the offer. Required, and Restrict rather than Cascade or SetNull:
  /// the ordinary delete of a user is soft and leaves this intact, and a
  /// physical deletion of someone with invitation history has to be a
  /// deliberate procedure that decides what happens to that history, not a
  /// side effect that erases or anonymises it.
  invitedById    String @map("invited_by_id") @db.Uuid

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)

  /// At most one open invitation per organization and email. Enforced here
  /// rather than by checking first, which races: re-inviting revokes the open
  /// one and inserts its replacement, and of two re-invites whose inserts
  /// overlap the second fails on this index. Expiry is deliberately not part of the
  /// predicate — an index predicate cannot read the clock.
  ///
  /// Prisma still generates an `organizationId_email` unique input for this
  /// index, and a findUnique through it would ignore the predicate. Never use
  /// it; an architecture spec forbids it.
  @@unique([organizationId, email], map: "invitations_open_organization_email_key", where: { acceptedAt: null, revokedAt: null })
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([invitedById])
  @@map("invitations")
}

/// A named group of an organization's members — the unit that owns services
/// and will respond to incidents.
///
/// Organizational configuration, not history, and hard-deleted. The deletion
/// principle every relationship follows: deleting configuration never silently
/// deletes operational resources or historical records. A team that owns
/// services cannot be deleted — the services' foreign key is Restrict, so the
/// delete is refused, never cascaded, until they are reassigned. A team that
/// has been responsible for any incident cannot be deleted at all: incidents
/// are never deleted, and their team key is Restrict too. It can be renamed.
///
/// Belonging to a team grants nothing. Authorization is the organization role
/// alone; there are no team roles or team-scoped permissions.
model Team {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  /// Derived from the name when the team is created, never supplied by a
  /// client, and never changed afterwards: renaming writes `name` only, so a
  /// URL built from the slug keeps working. Navigation and internal reference,
  /// not content.
  ///
  /// Because it is derived, its uniqueness also refuses a second team whose
  /// name differs only by case or punctuation ("Platform", "platform!") — at
  /// creation. A rename is held only to the exact-name unique below.
  slug           String
  /// Null when there is none. An empty string is normalised to null at the
  /// Zod boundary, so there is one way to say "no description".
  description    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  TeamMembership[]
  services     Service[]
  incidents    Incident[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  /// The target of composite foreign keys from tenant-owned children — team
  /// memberships, services, and incidents — and a lookup key that cannot be
  /// used without the organization: findUnique({ organizationId_id }).
  @@unique([organizationId, id])
  @@map("teams")
}

/// Places an organization member on a team.
///
/// References the organization Membership rather than the global User: a team
/// member is, by construction, a member of the organization, and removing
/// someone from the organization removes them from its teams by cascade.
///
/// Tenant consistency is a database invariant, not a service convention. Both
/// foreign keys are composite and share the one organization_id column, so the
/// team and the membership a row joins must belong to the same organization as
/// the row — and therefore to each other. Simple foreign keys on team_id and
/// membership_id alone would accept a team in one organization joined to a
/// membership in another.
///
/// Rows must be created with scalar ids (organizationId, teamId, membershipId),
/// not nested `connect`: the two relations share organizationId.
///
/// Hard lifecycle. The surrogate id follows the schema convention and is not
/// exposed; the API addresses a team member by its membership id.
model TeamMembership {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team       @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  /// A person is on a team at most once. Membership is one per user per
  /// organization, so this is also one per user per team. Its leading column
  /// serves the cascade from teams.
  @@unique([teamId, membershipId])
  /// Serves the cascade from memberships, and "which teams is this member on".
  @@index([membershipId])
  @@map("team_memberships")
}

/// How much an organization depends on a service: a classification people
/// choose, not an observed state. It is neither service health nor incident
/// severity, and nothing sorts or computes by it — it is shown, not scored.
///
/// Four plain words rather than numbered tiers, whose direction readers
/// disagree about, defined without any industry's vocabulary:
///
///   CRITICAL  failure stops the organization's core work or directly harms
///             its customers
///   HIGH      failure seriously degrades important work; workarounds are
///             limited
///   NORMAL    failure is disruptive but contained — the default
///   LOW       internal or peripheral; failure has little impact
enum ServiceCriticality {
  CRITICAL
  HIGH
  NORMAL
  LOW

  @@map("service_criticality")
}

/// An operational component the organization runs — an API, a processor, a
/// portal — owned by one of its teams. What incidents will be recorded
/// against.
///
/// Every service has an owner. A service nobody owns is exactly the ambiguity
/// an incident tool exists to remove, and a required owner means the composite
/// foreign key below is checked on every row.
///
/// Tenant consistency is a database invariant, as for team memberships: the
/// owner key is composite on the service's own organization_id, so the owning
/// team must belong to the service's organization however the row is written.
/// Rows are created with scalar ids (organizationId, ownerTeamId), not nested
/// `connect`: the two relations share organizationId.
///
/// The owner key is Restrict on delete, so a team that owns services cannot be
/// deleted until they are reassigned, and Restrict on update, so a team cannot
/// be moved to another organization carrying its services with it. A physical
/// deletion of the organization still removes both: the cascade reaches teams
/// and services in the same statement, and schema.integration-spec.ts proves
/// Postgres completes it.
///
/// Retired by archiving, not deleting. Incidents reference a service through a
/// Restrict key, so a service with incident history cannot be deleted — the
/// history would otherwise disappear with it. Archiving (archivedAt) keeps it
/// resolvable from every incident that names it while refusing new incidents
/// against it. Deletion remains for a service nothing references: a mistake.
model Service {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  /// Derived from the name when the service is created, never supplied by a
  /// client, and never changed afterwards — the same rules as Team.slug.
  /// Navigation and internal reference, not content.
  slug           String
  /// Null when there is none; blank is normalised to null at the Zod boundary.
  description    String?
  ownerTeamId    String             @map("owner_team_id") @db.Uuid
  criticality    ServiceCriticality @default(NORMAL)
  /// Set when the service is retired. The one rule it carries: no new
  /// incident may be declared against an archived service, which the
  /// declaration checks under a row lock. Everything else — reading it,
  /// renaming it, its existing incidents — is unaffected. Public lifecycle
  /// state, unlike a deletedAt: it is returned in responses.
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerTeam    Team         @relation(fields: [organizationId, ownerTeamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  incidents    Incident[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  /// A lookup key that cannot be used without the organization, and the
  /// target of the composite foreign key incidents carry.
  @@unique([organizationId, id])
  /// Serves the Restrict check when a team is deleted, and "which services
  /// does this team own".
  @@index([organizationId, ownerTeamId])
  @@map("services")
}

/// How serious one incident is — chosen for the incident, never derived from
/// its service's criticality: a CRITICAL service can have a SEV4 incident.
/// Numbered because that is the vocabulary responders already use, SEV1 the
/// most severe; the enum is declared in that order, so ORDER BY puts SEV1
/// first. Industry-neutral:
///
///   SEV1  Critical  core functionality unavailable, or major customer or
///                   business impact
///   SEV2  Major     serious degradation or substantial impact, short of a
///                   complete critical outage
///   SEV3  Moderate  limited or contained impact; normal operations largely
///                   continue
///   SEV4  Minor     a small operational issue with little immediate impact
enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4

  @@map("incident_severity")
}

/// Where the response to an incident stands. The three active statuses may
/// move in any direction — a fix that fails sends MONITORING back to
/// INVESTIGATING. RESOLVED is terminal: a resolved incident is not changed
/// again (reopening arrives with the incident timeline, where it is recorded).
///
///   INVESTIGATING  the problem is known; cause and fix are not
///   IDENTIFIED     the likely cause is known; remediation is under way
///   MONITORING     a fix or mitigation is in place; recovery is being watched
///   RESOLVED       the incident is over
enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED

  @@map("incident_status")
}

/// An operational problem affecting one of the organization's services,
/// declared by a member. Operational history: never deleted by the
/// application, and nothing it references can be deleted from under it.
///
/// Tenant consistency is a database invariant, as for services. The service
/// and team keys are composite and share the incident's organization_id, so
/// both must belong to the incident's own organization however the row is
/// written. Rows are created with scalar ids, not nested `connect`.
///
/// teamId is the team responsible for this incident. It is copied from the
/// service's owner when the incident is declared — a snapshot, so reassigning
/// the service later does not rewrite who was responsible — and may be
/// reassigned explicitly while the incident is active. serviceId never
/// changes after declaration.
///
/// Both keys are Restrict on delete, so a service or team an incident names
/// cannot be deleted, and Restrict on update, so neither can move to another
/// organization carrying incidents with it. A physical deletion of the
/// organization still removes everything: schema.integration-spec.ts proves
/// the cascade completes.
///
/// Two invariants live as CHECK constraints in the migration, because Prisma
/// cannot declare them (and does not treat them as drift): status is RESOLVED
/// exactly when resolved_at is set, and number is positive.
model Incident {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  /// The organization's own sequence, shown as INC-{number}. Allocated from
  /// organizations.last_incident_number when the incident is declared:
  /// unique within the organization, never changed, and increasing in the
  /// order declarations commit. Not promised to be gapless.
  number           Int
  title            String
  /// The current understanding of the impact. Null when there is none; blank
  /// is normalised to null at the Zod boundary.
  summary          String?
  serviceId        String           @map("service_id") @db.Uuid
  teamId           String           @map("team_id") @db.Uuid
  severity         IncidentSeverity
  status           IncidentStatus   @default(INVESTIGATING)
  /// Who declared it: the global User rather than the Membership. A
  /// membership is hard-deleted when access is revoked, and attribution must
  /// outlive the grant; a user is soft-deleted and keeps resolving. Restrict,
  /// like invitations.invited_by_id: a physical erasure must be a deliberate
  /// procedure, not a cascade. Users are global, so this is the one reference
  /// the database cannot hold to the organization — IncidentsService takes it
  /// from the admitted membership and never from a request body.
  createdById      String           @map("created_by_id") @db.Uuid
  /// The member leading the response, or null when nobody has been assigned.
  /// Assignment, not attribution: it names a current grant in this
  /// organization, so it references the Membership — through a composite key
  /// on the incident's own organization_id, which makes a lead from another
  /// organization unrepresentable. Never set automatically; declaring an
  /// incident does not make the declarer its lead. Carries no authority.
  leadMembershipId String?          @map("lead_membership_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Set by the server in the same write that sets RESOLVED; never supplied
  /// by a client.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service             @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  team         Team                @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User                @relation("IncidentsDeclared", fields: [createdById], references: [id], onDelete: Restrict)
  /// Restrict must be explicit. Prisma's default for an optional relation is
  /// SetNull, which on a composite key would null organization_id as well —
  /// a NOT NULL column.
  lead         Membership?         @relation("IncidentLead", fields: [organizationId, leadMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  responders   IncidentResponder[]
  activity     IncidentActivity[]

  /// The addressing key: the API names an incident by its number within the
  /// organization. Also serves keyset pages ordered by number.
  @@unique([organizationId, number])
  /// Redundant with the primary key; the target of the composite foreign keys
  /// incident_responders and incident_activities carry.
  @@unique([organizationId, id])
  /// Serves the Restrict check when a service is deleted.
  @@index([organizationId, serviceId])
  /// Serves the Restrict check when a team is deleted.
  @@index([organizationId, teamId])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([createdById])
  /// Serves the Restrict check when a membership is deleted.
  @@index([organizationId, leadMembershipId])
  /// Serves the overview's count of incidents declared in a period.
  @@index([organizationId, createdAt])
  /// Serves the overview's resolved-in-a-period count and its most recent.
  @@index([organizationId, resolvedAt])
  @@map("incidents")
}

/// Places an organization member on an incident's response.
///
/// Built like TeamMembership: both foreign keys are composite and share the
/// one organization_id column, so the incident and the membership a row joins
/// must belong to the same organization. Rows are created with scalar ids,
/// not nested `connect`.
///
/// Any member of the organization may respond, whichever team they are on.
/// Independent of the lead: the lead may or may not also be a responder.
///
/// Hard lifecycle: removing a responder deletes the row. The membership key
/// is Restrict, as for the lead; the incident key cascades, which only a
/// physical deletion of the organization ever exercises.
model IncidentResponder {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  incidentId     String @map("incident_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident   Incident   @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  /// A member responds to an incident at most once. Its leading column serves
  /// the cascade from incidents and listing an incident's responders.
  @@unique([incidentId, membershipId])
  /// Serves the Restrict check when a membership is deleted.
  @@index([membershipId])
  @@map("incident_responders")
}

/// What an incident's timeline entry records. UPDATE is written by a member;
/// the others are written by the server, in the transaction of the change
/// they describe. Resolution is STATUS_CHANGED to RESOLVED.
enum IncidentActivityType {
  DECLARED
  UPDATE
  SEVERITY_CHANGED
  STATUS_CHANGED

  @@map("incident_activity_type")
}

/// One entry on an incident's timeline: an operational update posted by a
/// member, or a lifecycle change recorded by the server.
///
/// History, not state. The incident row is the source of its current state;
/// nothing is ever reconstructed by replaying these rows. Entries are never
/// changed or deleted by the application.
///
/// The incident key is composite on the shared organization_id, so an entry
/// cannot be attached to another organization's incident. The actor is the
/// global User, for the reason Incident.createdById gives: attribution must
/// outlive the membership. It is taken from the admitted membership, never
/// from a body.
///
/// createdAt is set by IncidentsService while it holds the incident's row
/// lock, not left to the column default (the transaction's start), so entries
/// sort in the order their changes applied.
///
/// message is set for UPDATE only. fromValue and toValue carry enum values as
/// text: DECLARED sets toValue to the declared severity; SEVERITY_CHANGED and
/// STATUS_CHANGED set both.
model IncidentActivity {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  incidentId     String               @map("incident_id") @db.Uuid
  type           IncidentActivityType
  actorId        String               @map("actor_id") @db.Uuid
  message        String?
  fromValue      String?              @map("from_value")
  toValue        String?              @map("to_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident Incident @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Serves reading an incident's timeline in order, and the cascade.
  @@index([incidentId, createdAt])
  /// Serves the Restrict check when a user row is physically deleted.
  @@index([actorId])
  @@map("incident_activities")
}

/// One issued refresh token. A row per token rather than per session, because
/// rotation means a session is a *chain* of tokens: every refresh revokes the
/// presented token and inserts its successor.
///
/// Hard lifecycle. These are credentials, not history — an expired or revoked row
/// is reaped, not preserved, and nothing references one after it dies.
model RefreshToken {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque token, hex encoded. The token itself is never stored,
  /// so a database disclosure yields nothing a client can present.
  ///
  /// SHA-256 rather than Argon2, which would be wrong twice over: the token is 256
  /// bits from a CSPRNG, so there is no low-entropy guess for a slow hash to
  /// frustrate, and lookup happens *by* this value — which needs to be
  /// deterministic and indexable, exactly what a per-row salt destroys.
  tokenHash String @unique @map("token_hash")

  /// Shared by every token descended from one login, and the reason reuse
  /// detection works: a token replayed after the legitimate client has rotated
  /// past it kills the whole lineage rather than leaving both parties working.
  ///
  /// Not a foreign key — the family has no row of its own. Making it one would
  /// mean a sessions table this stage has no other use for.
  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set on rotation, on logout, and on every token in a family when reuse is
  /// detected. A revoked row is kept until it expires precisely so that replaying
  /// it can be *noticed*; deleting it on rotation would make reuse look like an
  /// unknown token.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves the cascade from users, and revoking every session a person holds.
  @@index([userId])
  /// Serves reuse detection, which revokes an entire family in one statement.
  @@index([familyId])
  @@map("refresh_tokens")
}
