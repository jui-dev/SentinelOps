# SentinelOps web — example environment configuration
#
# Next.js reads env files from this directory (apps/web), not from the
# workspace root. Copy this file to `.env.local` here and adjust.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
# Never put a secret in one.

# The API origin the browser calls — no path; `/api/v1` is appended.
# Must be on the same site as the web app (see docs/architecture.md), and the web
# app's origin must be listed in the API's CORS_ORIGIN. Use `localhost` for
# both in development: `127.0.0.1` is a different site.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Whether to offer invitations. Optional; defaults to false. Must match the API's
# INVITATIONS_ENABLED: while off, members are added by an admin with a one-time
# password, and the invitation routes do not exist.
# NEXT_PUBLIC_INVITATIONS_ENABLED=false

# Whether to offer creating an organization. Optional; defaults to false. Must
# match the API's REGISTRATION_ENABLED: while off, the login page has no
# Create an organization link, /register says sign-up is closed, and people
# join when an organization's Admin adds them.
# NEXT_PUBLIC_REGISTRATION_ENABLED=false
