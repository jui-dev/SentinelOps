{
  "name": "sentinelops",
  "version": "0.1.0",
  "private": true,
  "description": "Incident management for engineering teams: declare, respond, resolve, and learn.",
  "author": "jui-dev",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sentinelops/api --filter @sentinelops/web run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 run lint",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "db:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "db:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f postgres"
  }
}
